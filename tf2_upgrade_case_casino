<!DOCTYPE html>
<html lang="uk" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TF2 Апгрейдер та Рулетка Кейсів</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        tfDark: '#12100e',
                        tfCard: '#1d1916',
                        tfBorder: '#383029',
                        tfOrange: '#cf7329',
                        tfYellow: '#f2a900',
                        tfGreen: '#5b8f22',
                        tfRed: '#a82929',
                        // Кольори якості предметів TF2
                        qNormal: '#b2b2b2',
                        qUnique: '#7d6d00',
                        qVintage: '#476291',
                        qGenuine: '#4d7455',
                        qStrange: '#cf6a32',
                        qUnusual: '#8650ac',
                        qCommando: '#d32ce6',
                        qAssassin: '#eb4b4b',
                        qElite: '#af1414',
                        qAustralium: '#ffd700'
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome Іконки -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Стилі -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Teko:wght@500;700&family=Inter:wght@400;600;800&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #0c0a09;
            color: #e7e5e4;
            background-image: radial-gradient(circle at 50% 20%, #261f18 0%, #0c0a09 70%);
            min-height: 100vh;
        }

        .tf-font {
            font-family: 'Teko', sans-serif;
            letter-spacing: 1px;
        }

        /* Ефекти сяйва якості */
        .glow-unusual { box-shadow: 0 0 15px rgba(134, 80, 172, 0.5); border-color: #8650ac !important; }
        .glow-australium { box-shadow: 0 0 18px rgba(255, 215, 0, 0.6); border-color: #ffd700 !important; }
        .glow-strange { box-shadow: 0 0 12px rgba(207, 106, 50, 0.4); border-color: #cf6a32 !important; }
        .glow-elite { box-shadow: 0 0 12px rgba(175, 20, 20, 0.5); border-color: #af1414 !important; }

        /* Кастомний скролбар */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #12100e; }
        ::-webkit-scrollbar-thumb { background: #383029; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #cf7329; }

        /* Стилі для каруселі кейсів */
        .case-carousel-wrapper {
            position: relative;
            overflow: hidden;
            width: 100%;
        }
        .case-carousel-track {
            display: flex;
            transition: transform 6s cubic-bezier(0.1, 0.9, 0.2, 1);
            will-change: transform;
        }
        .carousel-indicator {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 4px;
            background: #f2a900;
            box-shadow: 0 0 12px #f2a900;
            z-index: 20;
            transform: translateX(-50%);
        }

        /* Контейнер рулетки */
        .radial-wheel-container {
            position: relative;
            width: 280px;
            height: 280px;
        }

        .text-glow {
            text-shadow: 0 0 8px currentColor;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen select-none">

    <!-- ВЕРХНЯ НАВІГАЦІЯ -->
    <header class="bg-tfDark border-b border-tfBorder sticky top-0 z-40 shadow-xl">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <!-- Логотип та Назва -->
            <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('upgrader')">
                <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-tfOrange to-amber-700 flex items-center justify-center text-white shadow-lg border border-amber-400/30">
                    <i class="fa-solid fa-crosshairs text-xl animate-pulse"></i>
                </div>
                <div>
                    <h1 class="tf-font text-2xl font-bold tracking-wider text-amber-500 leading-none">TF2<span class="text-white">UPGRADER</span></h1>
                    <p class="text-[11px] text-stone-300 font-semibold tracking-wide">Самий кращий апгрейдер по Team Fortress 2</p>
                </div>
            </div>

            <!-- Посилання Навігації -->
            <nav class="hidden md:flex items-center gap-1 bg-stone-900/80 p-1 rounded-xl border border-tfBorder">
                <button id="nav-upgrader" onclick="switchTab('upgrader')" class="px-5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-tfOrange bg-stone-800">
                    <i class="fa-solid fa-bolt"></i> Апгрейдер
                </button>
                <button id="nav-cases" onclick="switchTab('cases')" class="px-5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-stone-400 hover:text-white">
                    <i class="fa-solid fa-box-open"></i> Кейси
                </button>
                <button id="nav-store" onclick="switchTab('store')" class="px-5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-stone-400 hover:text-white">
                    <i class="fa-solid fa-store"></i> Магазин
                </button>
                <button id="nav-inventory" onclick="switchTab('inventory')" class="px-5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-stone-400 hover:text-white">
                    <i class="fa-solid fa-backpack"></i> Інвентар <span id="nav-inv-count" class="bg-stone-800 text-xs px-2 py-0.5 rounded-full border border-stone-700">0</span>
                </button>
                <button id="nav-withdraw" onclick="switchTab('withdraw')" class="px-5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-stone-400 hover:text-white">
                    <i class="fa-solid fa-arrow-up-from-bracket"></i> Вивід
                </button>
            </nav>

            <!-- Баланс та Акаунт -->
            <div class="flex items-center gap-3">
                <!-- Баланс Металу -->
                <div class="bg-stone-900/90 border border-tfBorder px-3 py-1.5 rounded-xl flex items-center gap-3">
                    <div class="flex items-center gap-1.5" title="Очищений метал (Refined)">
                        <i class="fa-solid fa-cubes text-amber-500"></i>
                        <span id="user-balance-ref" class="font-bold text-amber-400 text-sm">100.00</span>
                        <span class="text-xs text-stone-400 font-semibold">Реф</span>
                    </div>
                    <div class="h-4 w-[1px] bg-stone-700"></div>
                    <button onclick="openDepositModal()" class="text-xs bg-tfOrange hover:bg-amber-600 text-white font-bold px-2 py-1 rounded transition" title="Поповнити">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>

                <!-- Кнопка Входу Steam / Профіль -->
                <div id="user-profile-btn" class="relative">
                    <!-- Заповнюється через JS -->
                </div>

                <!-- Кнопка Адмін Панелі -->
                <button onclick="openAdminModal()" class="w-9 h-9 bg-stone-800 hover:bg-stone-700 border border-stone-700 rounded-xl flex items-center justify-center text-stone-400 hover:text-amber-400 transition" title="Адмін панель">
                    <i class="fa-solid fa-user-shield"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- МОБІЛЬНЕ МЕНЮ (Нижня панель) -->
    <div class="md:hidden fixed bottom-0 left-0 right-0 bg-tfDark border-t border-tfBorder z-40 flex justify-around p-2">
        <button onclick="switchTab('upgrader')" class="flex flex-col items-center text-xs text-tfOrange py-1">
            <i class="fa-solid fa-bolt text-base mb-1"></i> Апгрейд
        </button>
        <button onclick="switchTab('cases')" class="flex flex-col items-center text-xs text-stone-400 py-1">
            <i class="fa-solid fa-box-open text-base mb-1"></i> Кейси
        </button>
        <button onclick="switchTab('store')" class="flex flex-col items-center text-xs text-stone-400 py-1">
            <i class="fa-solid fa-store text-base mb-1"></i> Магазин
        </button>
        <button onclick="switchTab('inventory')" class="flex flex-col items-center text-xs text-stone-400 py-1">
            <i class="fa-solid fa-backpack text-base mb-1"></i> Інвентар
        </button>
        <button onclick="switchTab('withdraw')" class="flex flex-col items-center text-xs text-stone-400 py-1">
            <i class="fa-solid fa-arrow-up-from-bracket text-base mb-1"></i> Вивід
        </button>
    </div>

    <!-- ОСНОВНИЙ КОНТЕНТ -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6 pb-20 md:pb-6">

        <!-- ================= ВКЛАДКА 1: АПГРЕЙДЕР ================= -->
        <section id="tab-upgrader" class="tab-content block">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                
                <!-- Ліва колонка: Обрані предмети для ставки -->
                <div class="lg:col-span-4 bg-tfCard border border-tfBorder rounded-2xl p-4 shadow-xl">
                    <div class="flex items-center justify-between mb-3 border-b border-tfBorder pb-2">
                        <h2 class="tf-font text-xl text-stone-200 uppercase tracking-wide flex items-center gap-2">
                            <i class="fa-solid fa-hand-holding-dollar text-tfOrange"></i> Твоя ставка
                        </h2>
                        <span id="left-selected-value" class="text-sm font-bold text-amber-400">0.00 Реф</span>
                    </div>

                    <!-- Вікно обраних предметів -->
                    <div id="left-bet-box" class="min-h-[140px] bg-stone-950/60 rounded-xl border border-dashed border-stone-800 p-3 flex flex-wrap gap-2 items-center justify-center">
                        <p class="text-xs text-stone-500 text-center">Обери предмети з інвентарю нижче або вкажи чистий метал</p>
                    </div>

                    <!-- Введення чистих Рефінів -->
                    <div class="mt-3 flex items-center gap-2">
                        <span class="text-xs text-stone-400 font-semibold">Чисті Рефіни:</span>
                        <input type="number" id="raw-ref-input" value="0" min="0" step="1" oninput="updateBetFromRawRef()" class="w-full bg-stone-900 border border-stone-700 rounded-lg px-3 py-1.5 text-sm font-bold text-amber-400 focus:outline-none focus:border-tfOrange">
                    </div>

                    <!-- Вибір з інвентарю -->
                    <div class="mt-4">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-xs uppercase text-stone-400 font-bold">Предмети інвентарю</span>
                            <button onclick="selectAllInventory()" class="text-[11px] text-tfOrange hover:underline">Обрати все</button>
                        </div>
                        <div id="upgrader-inv-list" class="grid grid-cols-3 sm:grid-cols-4 gap-2 max-h-60 overflow-y-auto p-1 bg-stone-950/40 rounded-xl border border-stone-800/80">
                            <!-- Предмети додаються через JS -->
                        </div>
                    </div>
                </div>

                <!-- Центральна колонка: Колесо Шансів та Дія -->
                <div class="lg:col-span-4 flex flex-col items-center justify-center bg-tfCard/70 border border-tfBorder rounded-2xl p-6 shadow-2xl relative overflow-hidden">
                    
                    <div class="text-center mb-4">
                        <span class="text-xs font-bold uppercase tracking-widest text-stone-400">Множник</span>
                        <div id="multiplier-badge" class="tf-font text-3xl font-extrabold text-amber-400">1.00x</div>
                    </div>

                    <!-- Радіальне колесо -->
                    <div class="radial-wheel-container my-2 flex items-center justify-center">
                        <canvas id="wheelCanvas" width="280" height="280" class="rounded-full shadow-2xl"></canvas>
                        
                        <!-- Центр колеса -->
                        <div class="absolute inset-0 m-auto w-36 h-36 bg-tfDark rounded-full border-4 border-tfBorder shadow-inner flex flex-col items-center justify-center pointer-events-none z-10">
                            <span id="chance-percentage" class="tf-font text-4xl font-extrabold text-white leading-none">0.00%</span>
                            <span class="text-[10px] text-stone-400 font-bold uppercase tracking-widest">Шанс виграшу</span>
                        </div>
                    </div>

                    <!-- Вибір режиму та Кнопка -->
                    <div class="w-full mt-4 space-y-3">
                        <div class="flex bg-stone-900 p-1 rounded-xl border border-stone-800">
                            <button id="roll-under-btn" onclick="setRollMode('under')" class="flex-1 py-1.5 text-xs font-bold rounded-lg transition bg-tfOrange text-white">
                                <i class="fa-solid fa-arrow-down-short-wide"></i> Менше (0 - Шанс)
                            </button>
                            <button id="roll-over-btn" onclick="setRollMode('over')" class="flex-1 py-1.5 text-xs font-bold rounded-lg transition text-stone-400 hover:text-white">
                                <i class="fa-solid fa-arrow-up-wide-short"></i> Більше (100 - Шанс)
                            </button>
                        </div>

                        <!-- Кнопка Апгрейду -->
                        <button id="upgrade-action-btn" onclick="performUpgrade()" class="w-full py-3.5 bg-gradient-to-r from-tfOrange to-amber-600 hover:from-amber-600 hover:to-tfOrange text-white tf-font text-2xl font-bold tracking-wider rounded-xl shadow-lg border border-amber-400/30 transition transform active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed">
                            ПОЧАТИ АПГРЕЙД
                        </button>
                    </div>
                </div>

                <!-- Права колонка: Цільовий предмет -->
                <div class="lg:col-span-4 bg-tfCard border border-tfBorder rounded-2xl p-4 shadow-xl">
                    <div class="flex items-center justify-between mb-3 border-b border-tfBorder pb-2">
                        <h2 class="tf-font text-xl text-stone-200 uppercase tracking-wide flex items-center gap-2">
                            <i class="fa-solid fa-bullseye text-tfYellow"></i> Бажаний предмет
                        </h2>
                        <span id="right-target-value" class="text-sm font-bold text-amber-400">0.00 Реф</span>
                    </div>

                    <!-- Вікно цільового предмета -->
                    <div id="right-target-box" class="min-h-[140px] bg-stone-950/60 rounded-xl border border-dashed border-stone-800 p-3 flex flex-col items-center justify-center text-center">
                        <p class="text-xs text-stone-500">Обери бажаний предмет із каталогу нижче</p>
                    </div>

                    <!-- Каталог предметів -->
                    <div class="mt-4">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-xs uppercase text-stone-400 font-bold">Каталог предметів</span>
                            <div class="flex items-center gap-1">
                                <input type="text" id="target-search" oninput="renderTargetCatalog()" placeholder="Пошук..." class="bg-stone-900 border border-stone-800 rounded px-2 py-0.5 text-xs text-stone-200 focus:outline-none focus:border-tfOrange">
                            </div>
                        </div>
                        <div id="target-catalog-list" class="grid grid-cols-3 sm:grid-cols-4 gap-2 max-h-60 overflow-y-auto p-1 bg-stone-950/40 rounded-xl border border-stone-800/80">
                            <!-- Предмети каталогу додаються через JS -->
                        </div>
                    </div>
                </div>

            </div>
        </section>


        <!-- ================= ВКЛАДКА 2: КЕЙСИ ================= -->
        <section id="tab-cases" class="tab-content hidden">
            <!-- Вікно відкриття кейса -->
            <div class="bg-tfCard border border-tfBorder rounded-2xl p-6 shadow-2xl mb-8">
                <div class="text-center mb-4">
                    <h2 id="active-case-title" class="tf-font text-3xl font-extrabold text-amber-500">ЯЩИК MANN CO.</h2>
                    <p id="active-case-subtitle" class="text-xs text-stone-400">Крути рулетку та вибивай рідкісні аксесуари, Австралій та Незвичайні предмети!</p>
                </div>

                <!-- Рулетка відкриття -->
                <div class="case-carousel-wrapper bg-stone-950 border-y-2 border-tfBorder py-4 rounded-xl shadow-inner my-6">
                    <div class="carousel-indicator"></div>
                    <div id="case-carousel-track" class="case-carousel-track gap-3 px-4">
                        <!-- Картки рулетки генерація через JS -->
                    </div>
                </div>

                <!-- Кнопка відкриття та ціна -->
                <div class="flex flex-col items-center gap-3">
                    <div class="flex items-center gap-2 text-stone-300 font-semibold">
                        <span>Ціна відкриття:</span>
                        <span id="active-case-price" class="text-amber-400 font-bold text-lg">15.00 Реф</span>
                    </div>

                    <button id="open-case-btn" onclick="spinCaseCarousel()" class="px-10 py-3 bg-gradient-to-r from-tfOrange to-amber-600 hover:from-amber-600 hover:to-tfOrange text-white tf-font text-2xl font-bold tracking-wider rounded-xl shadow-lg border border-amber-400/30 transition transform active:scale-95 disabled:opacity-50">
                        ВІДКРИТИ КЕЙС
                    </button>
                </div>
            </div>

            <!-- Доступні кейси -->
            <div>
                <h3 class="tf-font text-2xl text-stone-200 mb-4 border-b border-tfBorder pb-2">Доступні Ящики Mann Co.</h3>
                <div id="cases-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Кейси додаються через JS -->
                </div>
            </div>
        </section>


        <!-- ================= ВКЛАДКА 3: МАГАЗИН ================= -->
        <section id="tab-store" class="tab-content hidden">
            <div class="bg-tfCard border border-tfBorder rounded-2xl p-6 shadow-xl">
                <!-- Фільтри та пошук -->
                <div class="flex flex-col md:flex-row gap-4 justify-between items-center mb-6 pb-4 border-b border-tfBorder">
                    <div>
                        <h2 class="tf-font text-3xl text-amber-500">МАГАЗИН ПРЕДМЕТІВ</h2>
                        <p class="text-xs text-stone-400">Купуй зброю, Австралій та Unusual шапки напряму за Очищений метал.</p>
                    </div>

                    <!-- Пошук та фільтри -->
                    <div class="flex flex-wrap gap-2 w-full md:w-auto">
                        <input type="text" id="store-search-input" oninput="renderStoreCatalog()" placeholder="Назва предмета..." class="bg-stone-900 border border-stone-700 text-stone-200 text-sm rounded-xl px-3 py-2 focus:outline-none focus:border-tfOrange flex-grow">
                        
                        <select id="store-filter-rarity" onchange="renderStoreCatalog()" class="bg-stone-900 border border-stone-700 text-stone-200 text-sm rounded-xl px-3 py-2 focus:outline-none focus:border-tfOrange">
                            <option value="all">Усі якості</option>
                            <option value="unusual">Незвичайний (Unusual)</option>
                            <option value="australium">Австралій (Australium)</option>
                            <option value="strange">Дивний (Strange)</option>
                            <option value="commando">Командо / Еліта</option>
                            <option value="unique">Унікальний</option>
                        </select>
                    </div>
                </div>

                <!-- Сітка магазину -->
                <div id="store-items-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                    <!-- Предмети магазину через JS -->
                </div>
            </div>
        </section>


        <!-- ================= ВКЛАДКА 4: ІНВЕНТАР ================= -->
        <section id="tab-inventory" class="tab-content hidden">
            <div class="bg-tfCard border border-tfBorder rounded-2xl p-6 shadow-xl">
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 pb-4 border-b border-tfBorder gap-4">
                    <div>
                        <h2 class="tf-font text-3xl text-amber-500">ТВІЙ ІНВЕНТАР</h2>
                        <p class="text-xs text-stone-400">Керуй виграними та купленими предметами. Продавай непотрібне за Метал.</p>
                    </div>

                    <div class="flex items-center gap-3">
                        <span id="inv-total-value" class="text-sm font-bold text-amber-400 bg-stone-950 px-3 py-1.5 rounded-xl border border-stone-800">Загальна вартість: 0.00 Реф</span>
                        <button onclick="sellAllItems()" class="bg-red-900/40 hover:bg-red-800 text-red-300 border border-red-700 text-xs font-bold px-3 py-2 rounded-xl transition">
                            Продати все
                        </button>
                    </div>
                </div>

                <!-- Сітка інвентарю -->
                <div id="inventory-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
                    <!-- Предмети інвентарю через JS -->
                </div>
            </div>
        </section>


        <!-- ================= ВКЛАДКА 5: ВИВІД В STEAM ================= -->
        <section id="tab-withdraw" class="tab-content hidden">
            <div class="bg-tfCard border border-tfBorder rounded-2xl p-6 shadow-xl">
                <div class="mb-6 pb-4 border-b border-tfBorder">
                    <h2 class="tf-font text-3xl text-amber-500 flex items-center gap-2">
                        <i class="fa-solid fa-arrow-up-from-bracket"></i> ВИВІД ПРЕДМЕТІВ В STEAM
                    </h2>
                    <p class="text-xs text-stone-400">Обери предмет зі свого інвентарю та вкажи Trade URL для отримання трейду від нашого бота.</p>
                </div>

                <!-- Поле Trade URL -->
                <div class="bg-stone-900 border border-stone-800 rounded-2xl p-4 mb-6">
                    <label class="text-xs text-stone-300 font-bold block mb-2">Твоє Steam Trade URL Посилання:</label>
                    <div class="flex gap-2">
                        <input type="text" id="steam-trade-url" placeholder="https://steamcommunity.com/tradeoffer/new/?partner=12345678&token=abc" class="w-full bg-stone-950 border border-stone-700 rounded-xl px-4 py-2 text-sm text-stone-200 focus:outline-none focus:border-tfOrange">
                        <button onclick="saveTradeUrl()" class="bg-tfOrange hover:bg-amber-600 text-white font-bold text-xs px-5 rounded-xl transition">
                            Зберегти
                        </button>
                    </div>
                    <p class="text-[11px] text-stone-500 mt-2">Де знайти Trade URL? Перейди в свій інвентар Steam ➔ Обміни ➔ Хто може надсилати мені пропозиції обміну.</p>
                </div>

                <!-- Список предметів для виводу -->
                <div>
                    <h3 class="tf-font text-2xl text-stone-200 mb-3">Обери предмет для виводу</h3>
                    <div id="withdraw-items-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
                        <!-- Динамічно заповнюється JS -->
                    </div>
                </div>
            </div>
        </section>

    </main>


    <!-- ================= МОДАЛЬНІ ВІКНА ================= -->

    <!-- АДМІН ПАНЕЛЬ МОДАЛКА -->
