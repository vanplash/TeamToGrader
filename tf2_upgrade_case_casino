        function switchTab(tabId) {
            playSound('click');
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');

            ['upgrader', 'cases', 'store', 'inventory', 'withdraw'].forEach(id => {
                const btn = document.getElementById(`nav-${id}`);
                if (btn) {
                    if (id === tabId) {
                        btn.className = "px-5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-tfOrange bg-stone-800";
                    } else {
                        btn.className = "px-5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-stone-400 hover:text-white";
                    }
                }
            });

            if (tabId === 'inventory') renderUserInventoryGrid();
            if (tabId === 'withdraw') renderWithdrawGrid();
        }


        /* ==========================================================================
           4. АУДІО
           ========================================================================== */

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playSound(type) {
            try {
                if (!audioCtx) initAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;

                if (type === 'click') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(800, now);
                    osc.frequency.exponentialRampToValueAtTime(400, now + 0.05);
                    gain.gain.setValueAtTime(0.1, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.05);
                    osc.start(now);
                    osc.stop(now + 0.05);
                } else if (type === 'tick') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(600, now);
                    gain.gain.setValueAtTime(0.05, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.03);
                    osc.start(now);
                    osc.stop(now + 0.03);
                } else if (type === 'win') {
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(440, now);
                    osc.frequency.setValueAtTime(554.37, now + 0.1);
                    osc.frequency.setValueAtTime(659.25, now + 0.2);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.4);
                    osc.start(now);
                    osc.stop(now + 0.4);
                } else if (type === 'loss') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(300, now);
                    osc.frequency.linearRampToValueAtTime(150, now + 0.3);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                }
            } catch (e) {}
        }


        /* ==========================================================================
           5. АКАУНТ КОРИСТУВАЧА
           ========================================================================== */

        function loadUserData() {
            const saved = localStorage.getItem('tf2_casino_user_ukr');
            if (saved) {
                currentUser = JSON.parse(saved);
            } else {
                currentUser = {
                    username: 'Scout_UA',
                    balance: 150.00,
                    inventory: [
                        { ...TF2_CATALOG[0], instanceId: 'inst_1' },
                        { ...TF2_CATALOG[1], instanceId: 'inst_2' }
                    ]
                };
                saveUserData();
            }
            updateUserUI();
        }

        function saveUserData() {
            if (currentUser) {
                localStorage.setItem('tf2_casino_user_ukr', JSON.stringify(currentUser));
            }
            updateUserUI();
        }

        function updateUserUI() {
            document.getElementById('user-balance-ref').innerText = currentUser.balance.toFixed(2);
            document.getElementById('nav-inv-count').innerText = currentUser.inventory.length;

            const profileContainer = document.getElementById('user-profile-btn');
            profileContainer.innerHTML = `
                <button onclick="openAuthModal()" class="flex items-center gap-2 bg-stone-900 border border-tfBorder px-3 py-1.5 rounded-xl hover:border-tfOrange transition">
                    <i class="fa-brands fa-steam text-tfOrange text-lg"></i>
                    <span class="text-xs font-bold text-stone-200">${currentUser.username}</span>
                </button>
            `;
        }


        /* ==========================================================================
           6. ЛОГІКА АПГРЕЙДЕРА
           ========================================================================== */

        function calculateUpgradeMetrics() {
            const betItemsTotal = selectedBetItems.reduce((acc, item) => acc + item.price, 0);
            const totalBet = betItemsTotal + rawRefBet;
            
            if (!selectedTargetItem || totalBet <= 0) {
                return { chance: 0, multiplier: 0, totalBet: 0 };
            }

            const targetPrice = selectedTargetItem.price;
            let chance = (totalBet / targetPrice) * 100;
            if (chance > 95) chance = 95;
            
            const multiplier = targetPrice / totalBet;

            return {
                chance: parseFloat(chance.toFixed(2)),
                multiplier: parseFloat(multiplier.toFixed(2)),
                totalBet: parseFloat(totalBet.toFixed(2))
            };
        }

        function updateUpgraderDisplay() {
            const metrics = calculateUpgradeMetrics();

            document.getElementById('chance-percentage').innerText = `${metrics.chance.toFixed(2)}%`;
            document.getElementById('multiplier-badge').innerText = `${metrics.multiplier.toFixed(2)}x`;
            document.getElementById('left-selected-value').innerText = `${metrics.totalBet.toFixed(2)} Реф`;
            document.getElementById('right-target-value').innerText = selectedTargetItem ? `${selectedTargetItem.price.toFixed(2)} Реф` : '0.00 Реф';

            drawWheel(metrics.chance);
        }

        function drawWheel(chancePercent, pointerAngle = 0) {
            const canvas = document.getElementById('wheelCanvas');
            const ctx = canvas.getContext('2d');
            const width = canvas.width;
            const height = canvas.height;
            const radius = width / 2 - 10;

            ctx.clearRect(0, 0, width, height);

            const center = width / 2;
            const chanceRad = (chancePercent / 100) * Math.PI * 2;

            ctx.beginPath();
            ctx.arc(center, center, radius, 0, Math.PI * 2);
            ctx.fillStyle = '#1c1917';
            ctx.fill();

            if (chancePercent > 0) {
                ctx.beginPath();
                ctx.moveTo(center, center);
                const startAngle = rollMode === 'under' ? -Math.PI / 2 : -Math.PI / 2 + (Math.PI * 2 - chanceRad);
                const endAngle = startAngle + chanceRad;

                ctx.arc(center, center, radius, startAngle, endAngle);
                ctx.closePath();
                ctx.fillStyle = '#cf7329';
                ctx.fill();
            }

            ctx.beginPath();
            ctx.arc(center, center, radius, 0, Math.PI * 2);
            ctx.strokeStyle = '#383029';
            ctx.lineWidth = 6;
            ctx.stroke();

            if (isSpinning) {
                ctx.save();
                ctx.translate(center, center);
                ctx.rotate(pointerAngle);
                
                ctx.beginPath();
                ctx.moveTo(0, -radius + 4);
                ctx.lineTo(-8, -radius - 12);
                ctx.lineTo(8, -radius - 12);
                ctx.closePath();
                ctx.fillStyle = '#f2a900';
                ctx.fill();

                ctx.restore();
            }
        }

        function performUpgrade() {
            if (isSpinning) return;
            const metrics = calculateUpgradeMetrics();

            if (!selectedTargetItem) {
                alert('Обери бажаний предмет з правого каталогу!');
                return;
            }

            if (metrics.totalBet <= 0) {
                alert('Обери предмети або вкажи Чистий Метал для ставки!');
                return;
            }

            if (rawRefBet > currentUser.balance) {
                alert('Недостатньо Очищеного Металу на балансі!');
                return;
            }

            isSpinning = true;
            document.getElementById('upgrade-action-btn').disabled = true;

            if (rawRefBet > 0) {
                currentUser.balance -= rawRefBet;
            }

            selectedBetItems.forEach(item => {
                const idx = currentUser.inventory.findIndex(i => i.instanceId === item.instanceId);
                if (idx !== -1) currentUser.inventory.splice(idx, 1);
            });
            saveUserData();

            let rollResult = Math.random() * 100;
            let isWin = false;

            if (rigMode === 'win') isWin = true;
            else if (rigMode === 'loss') isWin = false;
            else {
                isWin = rollMode === 'under' ? rollResult <= metrics.chance : rollResult >= (100 - metrics.chance);
            }

            let targetAngle = 0;
            if (isWin) {
                targetAngle = (metrics.chance / 200) * Math.PI * 2;
            } else {
                targetAngle = Math.PI + (Math.random() * Math.PI / 2);
            }

            let currentAngle = 0;
            const totalRounds = 4 * Math.PI * 2;
            const finalAngle = totalRounds + targetAngle;
            const startTime = performance.now();
            const duration = 3500;

            function animateSpin(now) {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easeOut = 1 - Math.pow(1 - progress, 3);

                currentAngle = easeOut * finalAngle;
                drawWheel(metrics.chance, currentAngle);

                if (Math.random() < 0.2) playSound('tick');

                if (progress < 1) {
                    requestAnimationFrame(animateSpin);
                } else {
                    isSpinning = false;
                    document.getElementById('upgrade-action-btn').disabled = false;

                    if (isWin) {
                        playSound('win');
                        const wonItem = { ...selectedTargetItem, instanceId: 'inst_' + Date.now() };
                        currentUser.inventory.unshift(wonItem);
                        saveUserData();
                        showWinModal(wonItem);
                    } else {
                        playSound('loss');
                        alert('Апгрейд невдалий! Твої предмети згоріли.');
                    }

                    selectedBetItems = [];
                    rawRefBet = 0;
                    document.getElementById('raw-ref-input').value = 0;
                    renderUpgraderInventory();
                    updateUpgraderDisplay();
                }
            }

            requestAnimationFrame(animateSpin);
        }

        function setRollMode(mode) {
            rollMode = mode;
            playSound('click');
            if (mode === 'under') {
                document.getElementById('roll-under-btn').className = "flex-1 py-1.5 text-xs font-bold rounded-lg transition bg-tfOrange text-white";
                document.getElementById('roll-over-btn').className = "flex-1 py-1.5 text-xs font-bold rounded-lg transition text-stone-400 hover:text-white";
            } else {
                document.getElementById('roll-over-btn').className = "flex-1 py-1.5 text-xs font-bold rounded-lg transition bg-tfOrange text-white";
                document.getElementById('roll-under-btn').className = "flex-1 py-1.5 text-xs font-bold rounded-lg transition text-stone-400 hover:text-white";
            }
            updateUpgraderDisplay();
        }

        function toggleSelectBetItem(instanceId) {
            playSound('click');
            const existingIndex = selectedBetItems.findIndex(i => i.instanceId === instanceId);
            if (existingIndex !== -1) {
                selectedBetItems.splice(existingIndex, 1);
            } else {
                const item = currentUser.inventory.find(i => i.instanceId === instanceId);
                if (item) selectedBetItems.push(item);
            }
            renderUpgraderInventory();
            renderSelectedBetBox();
            updateUpgraderDisplay();
        }

        function updateBetFromRawRef() {
            const val = parseFloat(document.getElementById('raw-ref-input').value) || 0;
            rawRefBet = Math.max(0, val);
            updateUpgraderDisplay();
        }

        function selectTargetItem(itemId) {
            playSound('click');
            selectedTargetItem = TF2_CATALOG.find(i => i.id === itemId);
            renderSelectedTargetBox();
            updateUpgraderDisplay();
        }


        /* ==========================================================================
           7. ВІДКРИТТЯ КЕЙСІВ
           ========================================================================== */

        function setupActiveCase(caseObj) {
            activeCase = caseObj;
            document.getElementById('active-case-title').innerText = caseObj.name.toUpperCase();
            document.getElementById('active-case-price').innerText = `${caseObj.price.toFixed(2)} Реф`;

            const track = document.getElementById('case-carousel-track');
            track.style.transition = 'none';
            track.style.transform = 'translateX(0px)';
            track.innerHTML = '';

            for (let i = 0; i < 30; i++) {
                const randomItemId = caseObj.items[Math.floor(Math.random() * caseObj.items.length)];
                const item = TF2_CATALOG.find(it => it.id === randomItemId) || TF2_CATALOG[0];
                track.appendChild(createCarouselCard(item));
            }
        }

        function createCarouselCard(item) {
            const card = document.createElement('div');
            card.className = `flex-shrink-0 w-32 h-36 bg-stone-900 border-2 ${getQualityBorderClass(item.quality)} rounded-xl p-2 flex flex-col items-center justify-between text-center shadow-lg`;
            card.innerHTML = `
                <span class="text-[10px] uppercase font-bold text-stone-400 tracking-wider">${getQualityName(item.quality)}</span>
                <img src="${item.img}" class="w-16 h-16 object-contain my-1">
                <span class="text-xs font-bold text-stone-200 truncate w-full">${item.name}</span>
            `;
            return card;
        }

        function spinCaseCarousel() {
            if (isSpinning) return;
            if (currentUser.balance < activeCase.price) {
                alert('Недостатньо Металу для відкриття кейсу!');
                return;
            }

            isSpinning = true;
            document.getElementById('open-case-btn').disabled = true;

            currentUser.balance -= activeCase.price;
            saveUserData();

            const winningItemId = activeCase.items[Math.floor(Math.random() * activeCase.items.length)];
            const winningItem = TF2_CATALOG.find(it => it.id === winningItemId) || TF2_CATALOG[0];

            const track = document.getElementById('case-carousel-track');
            track.style.transition = 'none';
            track.style.transform = 'translateX(0px)';

            track.innerHTML = '';
            const winnerIndex = 25;

            for (let i = 0; i < 35; i++) {
                let item = (i === winnerIndex) ? winningItem : TF2_CATALOG.find(it => it.id === activeCase.items[Math.floor(Math.random() * activeCase.items.length)]);
                track.appendChild(createCarouselCard(item));
            }

            const cardWidth = 128 + 12;
            const targetX = -(winnerIndex * cardWidth - (track.parentElement.clientWidth / 2) + 64);

            setTimeout(() => {
                track.style.transition = 'transform 5.5s cubic-bezier(0.15, 0.9, 0.2, 1)';
                track.style.transform = `translateX(${targetX}px)`;
            }, 50);

            let tickInterval = setInterval(() => {
                playSound('tick');
            }, 180);

            setTimeout(() => {
                clearInterval(tickInterval);
                isSpinning = false;
                document.getElementById('open-case-btn').disabled = false;

                playSound('win');
                const wonItem = { ...winningItem, instanceId: 'inst_' + Date.now() };
                currentUser.inventory.unshift(wonItem);
                saveUserData();
                showWinModal(wonItem);
            }, 5600);
        }

        function renderCasesGrid() {
            const container = document.getElementById('cases-grid');
            container.innerHTML = TF2_CASES.map(c => `
                <div class="bg-stone-900/90 border border-stone-800 rounded-2xl p-4 flex flex-col items-center text-center hover:border-tfOrange transition cursor-pointer" onclick="setupActiveCase(TF2_CASES.find(x=>x.id==='${c.id}'))">
                    <img src="${c.img}" class="w-24 h-24 object-contain mb-3">
                    <h4 class="font-bold text-stone-200 text-sm mb-1">${c.name}</h4>
                    <span class="text-xs text-amber-400 font-bold mb-3">${c.price.toFixed(2)} Реф</span>
                    <button class="w-full py-1.5 bg-stone-800 hover:bg-tfOrange text-stone-300 hover:text-white text-xs font-bold rounded-lg transition">Обрати Кейс</button>
                </div>
            `).join('');
        }


        /* ==========================================================================
           8. МАГАЗИН ТА ІНВЕНТАР
           ========================================================================== */

        function renderStoreCatalog() {
            const container = document.getElementById('store-items-grid');
            const search = document.getElementById('store-search-input').value.toLowerCase();
            const rarity = document.getElementById('store-filter-rarity').value;

            const filtered = TF2_CATALOG.filter(item => {
                const matchesSearch = item.name.toLowerCase().includes(search);
                const matchesRarity = rarity === 'all' || item.quality === rarity;
                return matchesSearch && matchesRarity;
            });

            container.innerHTML = filtered.map(item => `
                <div class="bg-stone-900 border-2 ${getQualityBorderClass(item.quality)} rounded-xl p-3 flex flex-col items-center justify-between text-center shadow-lg">
                    <span class="text-[10px] uppercase font-bold text-stone-400">${getQualityName(item.quality)}</span>
                    <img src="${item.img}" class="w-20 h-20 object-contain my-2">
                    <h4 class="text-xs font-bold text-stone-200 truncate w-full mb-1">${item.name}</h4>
                    <span class="text-xs font-bold text-amber-400 mb-2">${item.price.toFixed(2)} Реф</span>
                    <button onclick="buyStoreItem('${item.id}')" class="w-full py-1.5 bg-tfOrange hover:bg-amber-600 text-white text-xs font-bold rounded-lg transition">
                        Купити
                    </button>
                </div>
            `).join('');
        }

        function buyStoreItem(itemId) {
            playSound('click');
            const item = TF2_CATALOG.find(i => i.id === itemId);
            if (!item) return;

            if (currentUser.balance < item.price) {
                alert('Недостатньо Металу на балансі!');
                return;
            }

            currentUser.balance -= item.price;
            const purchasedItem = { ...item, instanceId: 'inst_' + Date.now() };
            currentUser.inventory.unshift(purchasedItem);
            saveUserData();

            playSound('win');
            alert(`Успішно куплено ${item.name}! Додано в інвентар.`);
        }

        function renderUserInventoryGrid() {
            const container = document.getElementById('inventory-grid');
            const totalVal = currentUser.inventory.reduce((acc, i) => acc + i.price, 0);
            document.getElementById('inv-total-value').innerText = `Загальна вартість: ${totalVal.toFixed(2)} Реф`;

            if (currentUser.inventory.length === 0) {
                container.innerHTML = `<p class="col-span-full text-center text-stone-500 py-10">Твій інвентар порожній. Відкривай кейси або купуй предмети в магазині!</p>`;
                return;
            }

            container.innerHTML = currentUser.inventory.map(item => `
                <div class="bg-stone-900 border-2 ${getQualityBorderClass(item.quality)} rounded-xl p-3 flex flex-col items-center justify-between text-center shadow-lg">
                    <span class="text-[10px] uppercase font-bold text-stone-400">${getQualityName(item.quality)}</span>
                    <img src="${item.img}" class="w-16 h-16 object-contain my-2">
                    <h4 class="text-xs font-bold text-stone-200 truncate w-full mb-1">${item.name}</h4>
                    <span class="text-xs font-bold text-amber-400 mb-2">${item.price.toFixed(2)} Реф</span>
                    <button onclick="sellInventoryItem('${item.instanceId}')" class="w-full py-1 bg-red-900/60 hover:bg-red-800 text-red-200 text-[11px] font-bold rounded-lg transition">
                        Продати за ${item.price.toFixed(2)} Реф
                    </button>
                </div>
            `).join('');
        }

        function sellInventoryItem(instanceId) {
            playSound('click');
            const index = currentUser.inventory.findIndex(i => i.instanceId === instanceId);
            if (index !== -1) {
                const item = currentUser.inventory[index];
                currentUser.balance += item.price;
                currentUser.inventory.splice(index, 1);
                saveUserData();
                renderUserInventoryGrid();
            }
        }

        function sellAllItems() {
            if (currentUser.inventory.length === 0) return;
            playSound('click');
            const totalVal = currentUser.inventory.reduce((acc, i) => acc + i.price, 0);
            currentUser.balance += totalVal;
            currentUser.inventory = [];
            saveUserData();
            renderUserInventoryGrid();
        }

        function renderUpgraderInventory() {
            const container = document.getElementById('upgrader-inv-list');
            container.innerHTML = currentUser.inventory.map(item => {
                const isSelected = selectedBetItems.some(i => i.instanceId === item.instanceId);
                return `
                    <div onclick="toggleSelectBetItem('${item.instanceId}')" class="bg-stone-900 border ${isSelected ? 'border-tfOrange ring-2 ring-tfOrange/50' : 'border-stone-800'} rounded-lg p-1.5 flex flex-col items-center text-center cursor-pointer hover:border-stone-600 transition">
                        <img src="${item.img}" class="w-10 h-10 object-contain">
                        <span class="text-[10px] font-bold text-stone-300 truncate w-full mt-1">${item.name}</span>
                        <span class="text-[9px] text-amber-400 font-semibold">${item.price.toFixed(2)} Реф</span>
                    </div>
                `;
            }).join('');
        }

        function renderTargetCatalog() {
            const container = document.getElementById('target-catalog-list');
            const search = document.getElementById('target-search').value.toLowerCase();

            const filtered = TF2_CATALOG.filter(i => i.name.toLowerCase().includes(search));

            container.innerHTML = filtered.map(item => {
                const isSelected = selectedTargetItem && selectedTargetItem.id === item.id;
                return `
                    <div onclick="selectTargetItem('${item.id}')" class="bg-stone-900 border ${isSelected ? 'border-tfOrange ring-2 ring-tfOrange/50' : 'border-stone-800'} rounded-lg p-1.5 flex flex-col items-center text-center cursor-pointer hover:border-stone-600 transition">
                        <img src="${item.img}" class="w-10 h-10 object-contain">
                        <span class="text-[10px] font-bold text-stone-300 truncate w-full mt-1">${item.name}</span>
                        <span class="text-[9px] text-amber-400 font-semibold">${item.price.toFixed(2)} Реф</span>
                    </div>
                `;
            }).join('');
        }

        function renderSelectedBetBox() {
            const container = document.getElementById('left-bet-box');
            if (selectedBetItems.length === 0 && rawRefBet <= 0) {
                container.innerHTML = `<p class="text-xs text-stone-500 text-center">Обери предмети з інвентарю нижче або вкажи чистий метал</p>`;
                return;
            }

            container.innerHTML = selectedBetItems.map(item => `
                <div class="bg-stone-900 border border-stone-700 rounded-lg p-1.5 flex items-center gap-2">
                    <img src="${item.img}" class="w-8 h-8 object-contain">
                    <div class="text-left">
                        <p class="text-[10px] font-bold text-stone-200 truncate w-20">${item.name}</p>
                        <p class="text-[9px] text-amber-400 font-semibold">${item.price.toFixed(2)} Реф</p>
                    </div>
                </div>
            `).join('');
        }

        function renderSelectedTargetBox() {
            const container = document.getElementById('right-target-box');
            if (!selectedTargetItem) {
                container.innerHTML = `<p class="text-xs text-stone-500">Обери бажаний предмет із каталогу нижче</p>`;
                return;
            }

            container.innerHTML = `
                <span class="text-[10px] uppercase font-bold text-stone-400 tracking-widest">${getQualityName(selectedTargetItem.quality)}</span>
                <img src="${selectedTargetItem.img}" class="w-20 h-20 object-contain my-2">
                <h4 class="text-sm font-bold text-stone-100">${selectedTargetItem.name}</h4>
                <span class="text-xs font-bold text-amber-400">${selectedTargetItem.price.toFixed(2)} Реф</span>
            `;
        }

        function selectAllInventory() {
            selectedBetItems = [...currentUser.inventory];
            renderUpgraderInventory();
            renderSelectedBetBox();
            updateUpgraderDisplay();
        }

        function getQualityBorderClass(quality) {
            switch(quality) {
                case 'unusual': return 'glow-unusual';
                case 'australium': return 'glow-australium';
                case 'strange': return 'glow-strange';
                case 'commando': return 'border-purple-600';
                default: return 'border-stone-700';
            }
        }

        function getQualityName(quality) {
            switch(quality) {
                case 'unusual': return 'Незвичайний';
                case 'australium': return 'Австралій';
                case 'strange': return 'Дивний';
                case 'commando': return 'Командо';
                default: return 'Унікальний';
            }
        }


        /* ==========================================================================
           9. ВИВІД ПРЕДМЕТІВ В STEAM (WITHDRAW)
           ========================================================================== */

        function renderWithdrawGrid() {
            const container = document.getElementById('withdraw-items-grid');
            if (currentUser.inventory.length === 0) {
                container.innerHTML = `<p class="col-span-full text-center text-stone-500 py-8">Немає предметів доступних для виводу.</p>`;
                return;
            }

            container.innerHTML = currentUser.inventory.map(item => `
                <div class="bg-stone-900 border-2 ${getQualityBorderClass(item.quality)} rounded-xl p-3 flex flex-col items-center justify-between text-center shadow-lg">
                    <span class="text-[10px] uppercase font-bold text-stone-400">${getQualityName(item.quality)}</span>
                    <img src="${item.img}" class="w-16 h-16 object-contain my-2">
                    <h4 class="text-xs font-bold text-stone-200 truncate w-full mb-1">${item.name}</h4>
                    <button onclick="initiateTrade('${item.instanceId}')" class="w-full py-1.5 bg-tfOrange hover:bg-amber-600 text-white text-xs font-bold rounded-lg transition flex items-center justify-center gap-1">
                        <i class="fa-solid fa-paper-plane"></i> Вивести
                    </button>
                </div>
            `).join('');
        }

        function saveTradeUrl() {
            const url = document.getElementById('steam-trade-url').value;
            if (!url.includes('steamcommunity.com/tradeoffer')) {
                alert('Будь ласка, вкажи дійсне посилання Steam Trade URL!');
                return;
            }
            tradeUrl = url;
            alert('Твоє посилання Trade URL успішно збережено!');
        }

        function initiateTrade(instanceId) {
            if (!tradeUrl) {
                alert('Спочатку вкажи та збережи свій Steam Trade URL у полі вище!');
                return;
            }

            const itemIndex = currentUser.inventory.findIndex(i => i.instanceId === instanceId);
            if (itemIndex === -1) return;

            const item = currentUser.inventory[itemIndex];

            // Відкриваємо модалку обміну
            document.getElementById('trade-modal').classList.remove('hidden');
            document.getElementById('trade-status-text').innerText = 'З\'єднання з Ботом Steam #402...';

            setTimeout(() => {
                document.getElementById('trade-status-text').innerText = 'Перевірка Steam Guard та Trade URL...';
            }, 1500);

            setTimeout(() => {
                document.getElementById('trade-status-text').innerText = `Формування пропозиції: [${item.name}]...`;
            }, 3000);

            setTimeout(() => {
                document.getElementById('trade-status-text').innerText = 'Пропозицію обміну надіслано в Steam! Перевір додаток.';
                document.getElementById('trade-spinner').className = "fa-solid fa-circle-check text-green-500";
                
                const btn = document.getElementById('trade-confirm-btn');
                btn.disabled = false;
                btn.className = "w-full py-2.5 bg-tfOrange hover:bg-amber-600 text-white font-bold rounded-xl transition";
                btn.innerText = "Закрити та Завершити";

                // Видаляємо предмет з інвентарю після виводу
                currentUser.inventory.splice(itemIndex, 1);
                saveUserData();
                renderWithdrawGrid();
            }, 4800);
        }

        function closeTradeModal() {
            document.getElementById('trade-modal').classList.add('hidden');
        }


        /* ==========================================================================
           10. АДМІН ПАНЕЛЬ ТА АВТОРИЗАЦІЯ
           ========================================================================== */

        function openAdminModal() {
            playSound('click');
            document.getElementById('admin-modal').classList.remove('hidden');
        }

        function closeAdminModal() {
            document.getElementById('admin-modal').classList.add('hidden');
        }

        function verifyAdminPin() {
            const pin = document.getElementById('admin-pin-input').value;
            if (pin === 'tf2admin' || pin === 'admin') {
                playSound('win');
                document.getElementById('admin-login-step').classList.add('hidden');
                document.getElementById('admin-controls-step').classList.remove('hidden');
            } else {
                alert('Невірний пароль адміністратора!');
            }
        }

        function adminAddRef() {
            const amt = parseFloat(document.getElementById('admin-ref-amount').value) || 0;
            currentUser.balance += amt;
            saveUserData();
            alert(`Успішно нараховано ${amt} Очищеного Металу!`);
        }

        function setRigMode(mode) {
            rigMode = mode;
            playSound('click');
            ['normal', 'win', 'loss'].forEach(m => {
                document.getElementById(`rig-${m}-btn`).className = m === mode ? 
                    "flex-1 py-2 rounded-xl text-xs font-bold border border-tfOrange bg-tfOrange text-white" : 
                    "flex-1 py-2 rounded-xl text-xs font-bold border border-stone-700 bg-stone-800 text-stone-300";
            });
        }

        function adminGrantGoldenPan() {
            const pan = TF2_CATALOG.find(i => i.id === 'item_golden_pan');
            if (pan) {
                currentUser.inventory.unshift({ ...pan, instanceId: 'inst_' + Date.now() });
                saveUserData();
                alert('Золоту Сковороду додано в інвентар!');
            }
        }

        function openAuthModal() {
            playSound('click');
            document.getElementById('auth-modal').classList.remove('hidden');
        }

        function closeAuthModal() {
            document.getElementById('auth-modal').classList.add('hidden');
        }

        function processSteamLogin() {
            const username = document.getElementById('steam-username-input').value || 'Scout_UA';
            currentUser.username = username;
            saveUserData();
            closeAuthModal();
            playSound('win');
            alert(`Ласкаво просимо, ${username}! Вхід через Steam успішно виконано.`);
        }

        function openDepositModal() {
            const amount = prompt("Вкажи кількість Очищеного Металу (Ref) для поповнення:", "50");
            if (amount && !isNaN(amount)) {
                currentUser.balance += parseFloat(amount);
                saveUserData();
                playSound('win');
                alert(`Баланс успішно поповнено на ${amount} Рефінів!`);
            }
        }

        function showWinModal(item) {
            document.getElementById('win-item-card').innerHTML = `
                <span class="text-[10px] uppercase font-bold text-stone-400">${getQualityName(item.quality)}</span>
                <img src="${item.img}" class="w-28 h-28 object-contain my-3">
                <h4 class="text-base font-bold text-stone-100">${item.name}</h4>
                <span class="text-sm font-bold text-amber-400">${item.price.toFixed(2)} Реф</span>
            `;
            document.getElementById('win-modal').classList.remove('hidden');
        }

        function closeWinModal() {
            document.getElementById('win-modal').classList.add('hidden');
        }
    </script>
</body>
</html>
